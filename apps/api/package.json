{
  "name": "@platformtrust/api",
  "version": "0.1.0",
  "private": true,
  "description": "PlatformTrust HTTP API application (NestJS).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node --watch dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.15",
    "@swc/core": "1.10.1",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "2.1.8",
    "rimraf": "6.0.1",
    "supertest": "7.0.0",
    "typescript": "5.7.2",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.8"
  }
}
