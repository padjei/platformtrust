# AI PlatformTrust - example environment configuration.
# Copy this file to .env and replace placeholders with real values.
# NEVER commit a populated .env. This file holds placeholders ONLY.

# --- Database (PostgreSQL) ---
# Full connection URL used by the API and Alembic.
DATABASE_URL=postgresql+psycopg://platformtrust:platformtrust@postgres:5432/platformtrust
# Individual parts consumed by the postgres container.
POSTGRES_USER=platformtrust
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=platformtrust

# --- Redis (used only when justified; enable the "redis" compose profile) ---
REDIS_URL=redis://redis:6379/0

# --- Azure ---
# Evidence storage. Replace with a real connection string in Azure Key Vault.
AZURE_BLOB_CONNECTION_STRING=REPLACE_WITH_AZURE_BLOB_CONNECTION_STRING
# Key Vault URL for secret resolution in deployed environments.
AZURE_KEY_VAULT_URL=https://REPLACE_WITH_VAULT_NAME.vault.azure.net/

# --- Service ports ---
API_PORT=8000
WEB_PORT=3000

# --- Auth ---
# Signing secret for JWTs. Generate a strong random value per environment.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# --- Runtime ---
# One of: development | staging | production
ENVIRONMENT=development
# One of: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- LLM ---
# LLM output never decides pass/fail, authorization, compliance, or risk scores.
LLM_PROVIDER=azure-openai
LLM_API_KEY=REPLACE_WITH_LLM_API_KEY

# --- Frontend ---
# Base URL the web app uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
