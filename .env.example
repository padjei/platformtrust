# PlatformTrust — example environment configuration
#
# Copy to `.env` for local development. Contains NON-SECRET settings only.
# Never commit a real `.env`. Secrets are loaded from the platform secret
# manager (e.g. Azure Key Vault), never from source control.

# Runtime environment: development | test | production
NODE_ENV=development

# PlatformTrust deployment context: local | dev | staging | production
PLATFORMTRUST_ENV=local

# Application ports (local development defaults)
WEB_PORT=3000
API_PORT=3001
AI_SERVICE_PORT=8000

# Logging level: debug | info | warn | error
LOG_LEVEL=info
