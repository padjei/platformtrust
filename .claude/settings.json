{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(pytest*)",
      "Bash(ruff*)",
      "Bash(mypy*)",
      "Bash(eslint*)",
      "Bash(tsc*)",
      "Bash(alembic *)",
      "Bash(docker compose *)",
      "Bash(playwright*)",
      "Bash(poetry *)",
      "Bash(uv *)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-push-to-main.sh",
            "timeout": 10,
            "statusMessage": "Checking push target..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-destructive-shell.sh",
            "timeout": 10,
            "statusMessage": "Checking for destructive commands..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-committed-migrations.sh",
            "timeout": 10,
            "statusMessage": "Checking migration immutability..."
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-credential-file-access.sh",
            "timeout": 10,
            "statusMessage": "Checking for credential access..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/secret-scan.sh 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Scanning for secrets..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto-format.sh 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatting..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-targeted-backend-tests.sh 2>/dev/null || true",
            "timeout": 120,
            "statusMessage": "Running targeted backend tests..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/warn-authorization-changes.sh 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking authorization-sensitive changes..."
          }
        ]
      }
    ]
  }
}
